# Google Places API (New) — server only. Never prefix with NEXT_PUBLIC_.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# Optional alias if GOOGLE_PLACES_API_KEY is unset.
# GOOGLE_API_KEY=

# Payload CMS — use the Neon *pooled* connection string (*-pooler.*).
# Direct 5432 (DATABASE_URL_UNPOOLED) often times out from Vercel/local networks.
PAYLOAD_SECRET=
DATABASE_URL=
# DATABASE_URL_UNPOOLED=
PREVIEW_SECRET=

# Public origin of the live site (https). Used as serverURL fallback.
NEXT_PUBLIC_SITE_URL=https://neurointegrativecareoflosgatos.com

# Local: http://localhost:3000
# Vercel Production / Preview: the public https origin (never localhost).
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Required on Vercel for media uploads; without it, /media 404s in production.
BLOB_READ_WRITE_TOKEN=

# Optional local admin bootstrap (never commit real values).
# CMS_ADMIN_EMAIL=
# CMS_ADMIN_PASSWORD=
